{
  "expo": {
    "name": "Artisan Marketplace",
    "slug": "artisan-marketplace",
    "scheme": "artisanmarketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F5E9DA"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record a voice note describing your product so the AI Cataloger can write the listing for you."
      }
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#F5E9DA" },
      "package": "com.artisanmarketplace.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": ["expo-router"],
    "extra": {
      "apiUrl": "http://localhost:5000/api"
    }
  }
}
