# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/artisan_marketplace

# Auth
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5

# AI / Translation providers (optional - app runs with mock fallbacks if unset)
TRANSLATION_PROVIDER=mock            # mock | google | azure
GOOGLE_TRANSLATE_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

SPEECH_PROVIDER=mock                 # mock | google | azure
GOOGLE_SPEECH_API_KEY=

IMAGE_ENHANCEMENT_PROVIDER=mock      # mock | openai | stability
OPENAI_API_KEY=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
